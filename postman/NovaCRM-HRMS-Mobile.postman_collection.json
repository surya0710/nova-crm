			"description": "Core HRMS mobile APIs — check-in, check-out, dashboard.",
			"item": [
				{
					"name": "Get Dashboard",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status is 200', () => pm.response.to.have.status(200));",
									"const json = pm.response.json();",
									"if (json.data?.actions) {",
									"    pm.collectionVariables.set('can_check_in', json.data.actions.can_check_in);",
									"    pm.collectionVariables.set('can_check_out', json.data.actions.can_check_out);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v1/attendance/dashboard",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "attendance", "dashboard"]
						},
						"description": "Permission: `ess.access`\n\nStates: not_checked_in, checked_in, checked_out, on_leave, holiday, weekend"
					},
