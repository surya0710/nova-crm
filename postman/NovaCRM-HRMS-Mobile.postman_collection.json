						"body": {
							"mode": "raw",
							"raw": "{}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/attendance/check-in",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "attendance", "check-in"]
						},
						"description": "Permission: `ess.access` + EmployeePolicy::clock\n\nEmpty body = clock in at now().\n\n422 if: already checked in, on leave, holiday, weekend, ineligible status."
