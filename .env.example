APP_NAME=NovaCRM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain

# XAMPP subdirectory example (uncomment when using http://localhost/nova-crm/public):
# APP_URL=http://localhost/nova-crm/public
# ASSET_URL=http://localhost/nova-crm/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Production: LOG_STACK=daily, LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=novacrm
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Development: keep the durable database queue and run `php artisan queue:work`.
# Production scale-out: use Redis and supervised workers when available.
DB_QUEUE_CONNECTION=
DB_QUEUE_TABLE=jobs
DB_QUEUE=default
# Must remain above the longest job timeout (workers use --timeout=360).
DB_QUEUE_RETRY_AFTER=390
QUEUE_FAILED_DRIVER=database-uuids
# Redis queue equivalents (used when QUEUE_CONNECTION=redis):
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=390

# Queue/scheduler health thresholds used by Platform Monitoring.
QUEUE_MONITORING_ENABLED=true
QUEUE_MONITORING_DB_CONNECTION=
QUEUE_MONITORING_WORKER_STALE_AFTER=90
QUEUE_MONITORING_HEALTH_WINDOW=60
QUEUE_MONITORING_BUSY_PENDING=100
QUEUE_MONITORING_DEGRADED_FAILED=1
SCHEDULER_STALE_AFTER=180

CACHE_STORE=database
# CACHE_PREFIX=
# Scale-out: CACHE_STORE=redis
DOCUMENTATION_CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sanctum SPA / first-party domains (comma-separated hostnames, no scheme)
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000,::1

# Enterprise UX feature flags (see config/features.php)
ENTERPRISE_SHELL=true
WORKSPACE_NAV=true
COMMAND_PALETTE=true
GLOBAL_SEARCH_MODAL=true
NOTIFICATION_DRAWER=true
THEME_SWITCHER=true
# UI chrome rollback: ENTERPRISE_SHELL=false

# Meta Business — PLATFORM application credentials only (NovaCRM's Meta app).
# Tenant access tokens are stored encrypted per organization in the database.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
# Optional; defaults to route('marketing.providers.callback', ['provider' => 'meta'])
META_REDIRECT_URI=
META_GRAPH_API_VERSION=v21.0
META_HTTP_TIMEOUT=15
META_OAUTH_SCOPES=business_management,ads_read,pages_show_list,pages_read_engagement,leads_retrieval
# META_GRAPH_BASE_URL=https://graph.facebook.com
# META_OAUTH_DIALOG_URL=https://www.facebook.com
# MARKETING_WEBHOOK_RATE_LIMIT=120

# Google Ads — PLATFORM application credentials only (NovaCRM's Google app).
# Tenant access/refresh tokens and optional customer IDs are stored per organization.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional; defaults to route('marketing.providers.callback', ['provider' => 'google_ads'])
GOOGLE_REDIRECT_URI=
GOOGLE_ADS_API_VERSION=v22
GOOGLE_HTTP_TIMEOUT=15
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/adwords,openid,email
# GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_TOKEN_INFO_URL=https://oauth2.googleapis.com/tokeninfo
# GOOGLE_REVOKE_URL=https://oauth2.googleapis.com/revoke
# GOOGLE_ADS_API_BASE_URL=https://googleads.googleapis.com
